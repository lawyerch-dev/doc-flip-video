{
  "name": "doc-flip-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node packages/engine/index.mjs",
    "demo": "npx serve . -p 8080 --no-clipboard",
    "server": "node packages/server/index.mjs",
    "studio": "node packages/server/index.mjs",
    "dev": "lsof -ti:33011 | xargs kill -9 2>/dev/null; lsof -ti:5174 | xargs kill -9 2>/dev/null; (cd packages/yft-design && pnpm dev &) ; (sleep 2 && open http://localhost:33011) & nodemon --watch packages/server --watch packages/frontend -e mjs,html,js,css --delay 1 packages/server/index.mjs",
    "mcp": "node packages/mcp/mcp-server.mjs",
    "lint": "eslint packages/ --ignore-pattern='**/node_modules/**' --ignore-pattern='**/vendor/**' --ignore-pattern='**/workflow-studio/**' --ignore-pattern='**/build/**' --ignore-pattern='**/dist/**' --ignore-pattern='packages/yft-design/**'",
    "format": "prettier --write 'packages/**/*.{mjs,js,json,css,html}'",
    "format:check": "prettier --check 'packages/**/*.{mjs,js,json,css,html}'",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky",
    "fonts": "bash scripts/download-fonts.sh"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "jsbarcode": "^3.12.3",
    "openai": "^6.46.0",
    "puppeteer": "^25.3.0",
    "satori": "^0.28.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "puppeteer"
    ]
  }
}
