{
  "name": "doc-flip-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node packages/engine/build.mjs",
    "workflow": "pnpm --filter @doc-flip/workflow-engine workflow",
    "build:wf": "node packages/engine/build.mjs --workflow",
    "studio:flow": "pnpm --filter @doc-flip/workflow-studio dev",
    "demo": "npx serve . -p 8080 --no-clipboard",
    "server": "node packages/server/index.mjs",
    "studio": "node packages/server/index.mjs",
    "dev": "lsof -ti:33011 | xargs kill -9 2>/dev/null; lsof -ti:5173 | xargs kill -9 2>/dev/null; (sleep 3 && open http://localhost:33011) & concurrently -n server,studio 'nodemon --watch packages/server --watch packages/frontend -e mjs,html,js,css --delay 1 packages/server/index.mjs' 'pnpm --filter @doc-flip/workflow-studio dev'",
    "mcp": "node packages/mcp/mcp-server.mjs",
    "fonts": "bash scripts/download-fonts.sh"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "jsbarcode": "^3.12.3",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "puppeteer"
    ]
  }
}
