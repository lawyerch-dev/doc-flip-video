{
  "name": "法务视频示例",
  "canvas": {
    "width": 1080,
    "height": 1840,
    "fps": 30
  },
  "variables": {
    "issueNumber": 1
  },
  "nodes": [
    {
      "id": "cover",
      "name": "封面页",
      "content": {
        "kind": "image",
        "source": "data/temp/issue-001/cover.png"
      },
      "effects": [
        {
          "type": "hold",
          "params": { "duration": 2.0 }
        },
        {
          "type": "transition",
          "params": {
            "duration": 2.5,
            "transition": "page-curl",
            "easing": "cubic-in-out"
          }
        }
      ]
    },
    {
      "id": "content",
      "name": "内容页",
      "content": {
        "kind": "image",
        "source": "data/temp/issue-001/content-hl.png"
      },
      "effects": [
        {
          "type": "hold",
          "params": { "duration": 3.0 }
        },
        {
          "type": "fade-out",
          "params": { "duration": 2.0 }
        }
      ]
    }
  ],
  "audio": {
    "source": "assets/music"
  },
  "output": {
    "filename": "demo-v2.mp4"
  }
}
